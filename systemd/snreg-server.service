[Unit]
Description=SNReg server
Documentation=https://github.com/SNReg/snreg-docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=snreg
Group=snreg
ExecStart=/usr/bin/snreg-server serve
EnvironmentFile=-/etc/snreg/server.env
# The master key stays root-only on disk; systemd hands the service a private copy (spec §7).
LoadCredential=master.key:/etc/snreg/master.key
Environment=SNREG_MASTER_KEY_FILE=%d/master.key
# Kernel WireGuard (snreg0) needs CAP_NET_ADMIN; nothing else is granted (spec §8).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=snreg
Restart=on-failure

[Install]
WantedBy=multi-user.target
