[Unit]
Description=SNReg server
Documentation=https://github.com/SNReg/snreg-docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=snreg
Group=snreg
ExecStart=/usr/bin/snreg-server
EnvironmentFile=-/etc/snreg/server.env
# Kernel WireGuard (snreg0) needs CAP_NET_ADMIN; nothing else is granted (spec §8).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=snreg
Restart=on-failure

[Install]
WantedBy=multi-user.target
